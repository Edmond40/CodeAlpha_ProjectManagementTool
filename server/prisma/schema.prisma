generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamVisibility {
  PRIVATE
  PUBLIC
}

enum TeamColorTheme {
  INDIGO
  VIOLET
  BLUE
  EMERALD
  ROSE
}

enum TeamMemberRole {
  ADMIN
  MANAGER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum NotificationState {
  READ
  UNREAD
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  name          String
  password      String
  avatarUrl     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  teams         TeamMember[]
  createdTeams  Team[]
  invitations   TeamInvitation[] @relation("InvitationReceiver")
  sentInvitations TeamInvitation[] @relation("InvitationSender")
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[]           @relation("TaskCreator")
  notifications Notification[]
  activityLogs  TeamActivity[]
}

model Team {
  id             String              @id @default(uuid())
  name           String
  identifier     String              @unique
  description    String?
  visibility     TeamVisibility      @default(PRIVATE)
  timezone       String              @default("UTC")
  colorTheme     TeamColorTheme      @default(INDIGO)
  logo           String?
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  members        TeamMember[]
  invitations    TeamInvitation[]
  settings       TeamSettings?
  analytics      TeamAnalytics?
  activities     TeamActivity[]
  projects       Project[]
  tasks          Task[]
  notifications  Notification[]
  sprintCycles   SprintCycle[]
  rolePermissions TeamRolePermission[]
}

model TeamMember {
  id        String        @id @default(uuid())
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  team      Team          @relation(fields: [teamId], references: [id])
  teamId    String
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime      @default(now())
  isActive  Boolean       @default(true)
  userEmail String

  @@unique([userId, teamId])
}

model TeamInvitation {
  id           String           @id @default(uuid())
  team         Team             @relation(fields: [teamId], references: [id])
  teamId       String
  invitedBy    User             @relation("InvitationSender", fields: [invitedById], references: [id])
  invitedById  String
  invitedUser  User?            @relation("InvitationReceiver", fields: [userId], references: [id])
  userId       String?
  email        String
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  role         TeamMemberRole   @default(MEMBER)
  createdAt    DateTime         @default(now())
  expiresAt    DateTime?
}

model TeamSettings {
  id                 String   @id @default(uuid())
  team               Team     @relation(fields: [teamId], references: [id])
  teamId             String   @unique
  workflowConfig     Json     @default("{}")
  sprintConfig       Json     @default("{}")
  notificationConfig Json     @default("{}")
  permissionConfig   Json     @default("{}")
  productivityConfig Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TeamAnalytics {
  id               String   @id @default(uuid())
  team             Team     @relation(fields: [teamId], references: [id])
  teamId           String   @unique
  completedTasks   Int      @default(0)
  productivityPct  Float    @default(0.0)
  sprintVelocity   Float    @default(0.0)
  activeMembers    Int      @default(0)
  weeklyPerformance Json     @default("{}")
  workloadSummary  Json     @default("{}")
  updatedAt        DateTime @updatedAt
}

model TeamActivity {
  id          String   @id @default(uuid())
  team        Team     @relation(fields: [teamId], references: [id])
  teamId      String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  action      String
  details     Json?
  category    String
  createdAt   DateTime @default(now())
}

model Project {
  id          String    @id @default(uuid())
  team        Team      @relation(fields: [teamId], references: [id])
  teamId      String
  name        String
  description String?
  color       String?   @default("indigo")
  status      String    @default("active")
  startedAt   DateTime?
  dueDate     DateTime?
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
}

model Task {
  id           String          @id @default(uuid())
  team         Team            @relation(fields: [teamId], references: [id])
  teamId       String
  project      Project?        @relation(fields: [projectId], references: [id])
  projectId    String?
  title        String
  description  String?
  status       TaskStatus     @default(TODO)
  priority     TaskPriority   @default(MEDIUM)
  labels       String[]        @default([])
  dueDate      DateTime?
  assigneeId   String?
  assignee     User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  attachments  Json?           @default("[]")
  subtasks     Json?           @default("[]")
  comments     Json?           @default("[]")
  boardColumn  String?         
  createdById  String
  createdBy    User            @relation("TaskCreator", fields: [createdById], references: [id])
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())
}

model Notification {
  id          String            @id @default(uuid())
  user        User              @relation(fields: [userId], references: [id])
  userId      String
  team        Team              @relation(fields: [teamId], references: [id])
  teamId      String
  title       String
  message     String
  meta        Json?
  state       NotificationState @default(UNREAD)
  createdAt   DateTime          @default(now())
}

model SprintCycle {
  id          String      @id @default(uuid())
  team        Team        @relation(fields: [teamId], references: [id])
  teamId      String
  name        String
  status      SprintStatus @default(PLANNED)
  startDate   DateTime
  endDate     DateTime
  goals       Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model TeamRolePermission {
  id            String   @id @default(uuid())
  team          Team     @relation(fields: [teamId], references: [id])
  teamId        String
  role          TeamMemberRole
  permissions   String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([teamId, role])
}
